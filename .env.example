# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Required for real user authentication (Sign up, Login, Password reset, Session management).
# Obtain these from your Supabase Project Settings -> API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# CLOUDFLARE TURNSTILE CAPTCHA (Attack Protection / Bot Defense):
# When Bot Protection is enabled in Supabase Dashboard (Authentication -> Attack Protection -> Bot Protection),
# provide your Cloudflare Turnstile public Site Key here.
# Note: The Turnstile Secret Key MUST ONLY be entered in the Supabase Dashboard and NEVER exposed here or in client code.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

